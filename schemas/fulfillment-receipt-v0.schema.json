{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fireproof.dev/action-receipt/v0/fulfillment-receipt.schema.json",
  "title": "FireProof Fulfillment Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "receipt_id",
    "issued_at",
    "authority",
    "action",
    "outcome",
    "evidence"
  ],
  "properties": {
    "kind": {
      "const": "fulfillment-receipt"
    },
    "schema_version": {
      "const": "0.1"
    },
    "receipt_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "issued_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "payload_sha256"
      ],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_digest"
      ],
      "properties": {
        "intent_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "result_digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "aborted"
          ]
        },
        "result_digest": {
          "$ref": "#/$defs/sha256"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "artifact",
              "system_log",
              "external_receipt"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fireproof.dev/receiver-acceptance/v0.1/common.schema.json",
  "title": "FireProof Receiver Acceptance v0.1 Common Definitions",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64url_32_bytes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "canonical_standard_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1048576,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "ed25519_signature_standard_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "jwk_thumbprint_sha256": {
      "$ref": "#/$defs/base64url_32_bytes"
    },
    "ed25519_public_jwk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "$ref": "#/$defs/base64url_32_bytes"
        }
      }
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ascii_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scoped_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "const": "fireproof.receiver-acceptance.erp-supplier-master/v0.1"
    },
    "operation_ref": {
      "const": "supplier.payment-destination.replace"
    },
    "permitted_field": {
      "const": "payment_destination"
    },
    "dsse_media_type": {
      "const": "application/vnd.fireproof.dsse-envelope.v1+json"
    }
  }
}

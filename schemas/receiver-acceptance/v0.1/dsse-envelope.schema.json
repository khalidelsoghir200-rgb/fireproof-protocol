{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fireproof.dev/receiver-acceptance/v0.1/dsse-envelope.schema.json",
  "title": "FireProof R2 Strict DSSE Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "properties": {
    "payloadType": {
      "enum": [
        "application/vnd.fireproof.receiver-trust-manifest.v0+json",
        "application/vnd.fireproof.receiver-authority.v0+json",
        "application/vnd.fireproof.receiver-fulfillment.v0+json"
      ]
    },
    "payload": {
      "$ref": "https://schemas.fireproof.dev/receiver-acceptance/v0.1/common.schema.json#/$defs/canonical_standard_base64"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyid",
          "sig"
        ],
        "properties": {
          "keyid": {
            "$ref": "https://schemas.fireproof.dev/receiver-acceptance/v0.1/common.schema.json#/$defs/jwk_thumbprint_sha256"
          },
          "sig": {
            "$ref": "https://schemas.fireproof.dev/receiver-acceptance/v0.1/common.schema.json#/$defs/ed25519_signature_standard_base64"
          }
        }
      }
    }
  },
  "$comment": "The verifier must decode canonical padded standard base64, require decoded payload bytes to equal JCS(payload), and verify standard DSSE v1 PAE with Ed25519."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fireproof.dev/action-receipt/v0/authority-decision.schema.json",
  "title": "FireProof Authority Decision v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "receipt_id",
    "issued_at",
    "expires_at",
    "actor",
    "delegation",
    "policy",
    "action",
    "decision"
  ],
  "properties": {
    "kind": {
      "const": "authority-decision"
    },
    "schema_version": {
      "const": "0.1"
    },
    "receipt_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "issued_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "agent_kind"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "agent_kind": {
          "enum": [
            "ai_agent",
            "service"
          ]
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegator_id",
        "delegation_id"
      ],
      "properties": {
        "delegator_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "delegation_id": {
          "$ref": "#/$defs/safe_identifier"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "version",
        "sha256"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "action_name",
        "intent_digest"
      ],
      "properties": {
        "action_type": {
          "enum": [
            "mcp_tool",
            "http_write",
            "code_change",
            "payment",
            "custom"
          ]
        },
        "action_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "intent_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decision": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    }
  },
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "safe_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

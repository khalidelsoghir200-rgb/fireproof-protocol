{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireproof.dev/schemas/evidence-bundle/v0.1/evidence-bundle.schema.json",
  "title": "FireProof Evidence Bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "bundle_kind", "profile", "entries"],
  "properties": {
    "format": {"const": "fireproof.evidence-bundle/v0.1"},
    "bundle_kind": {"enum": ["action", "decision"]},
    "profile": {"const": "fireproof.action-receipt/v0.2"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "media_type", "sha256"],
        "properties": {
          "role": {"enum": ["manifest", "authority", "fulfillment", "disclosure"]},
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
          },
          "media_type": {"type": "string", "minLength": 1, "maxLength": 160},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
